#include <windows.h>
#pragma code_page(65001)
100 DIALOGEX 0, 0, 230, 80
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "BO1 Delirium"
FONT 9, "Segoe UI"
BEGIN
 LTEXT "Elige tu idioma / Choose your language", -1, 14, 13, 202, 16
 DEFPUSHBUTTON "Español", 1001, 28, 42, 78, 23
 PUSHBUTTON "English", 1002, 123, 42, 78, 23
END
1 VERSIONINFO
 FILEVERSION @BO1_RC_VERSION@
 PRODUCTVERSION @BO1_RC_VERSION@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @BO1_RC_TYPE@
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "@BO1_RC_DESCRIPTION@\0"
   VALUE "FileVersion", "@BO1_DISPLAY_VERSION@\0"
   VALUE "OriginalFilename", "@BO1_RC_FILENAME@\0"
   VALUE "ProductName", "BO1 Delirium\0"
   VALUE "ProductVersion", "@BO1_DISPLAY_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
